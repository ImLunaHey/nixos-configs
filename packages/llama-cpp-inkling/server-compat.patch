+// JSON sort_keys applies recursively without mutating the template's input objects.
+static value sorted_json_value(const value & input) {
+    if (is_val<value_object>(input)) {
+        auto pairs = input->as_ordered_object();
+        std::sort(pairs.begin(), pairs.end(), [](const auto & a, const auto & b) {
+            return a.first->as_string().str() < b.first->as_string().str();
+        });
+        for (auto & pair : pairs) pair.second = sorted_json_value(pair.second);
+        return mk_val<value_object>(pairs);
+    }
+    if (is_val<value_array>(input)) {
+        auto values = input->as_array();
+        for (auto & v : values) v = sorted_json_value(v);
+        return mk_val<value_array>(values);
+    }
+    return input;
+}
