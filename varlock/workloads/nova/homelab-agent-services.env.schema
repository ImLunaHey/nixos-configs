# @plugin(@varlock/hashicorp-vault-plugin@2.1.2)
# @initHcpVault(url=$BAO_ADDR, roleId=$VAULT_ROLE_ID, secretId=$VAULT_SECRET_ID)
# ---
BAO_ADDR=https://openbao.home.arpa:8200
VAULT_ROLE_ID=
# @sensitive
VAULT_SECRET_ID=
# @sensitive
HOMELAB_AGENT_SECRET=vaultSecret("secret/workloads/nova/homelab-agent-services#homelab_agent_secret")
# @sensitive
UPTIME_KUMA_PASSWORD=vaultSecret("secret/workloads/nova/homelab-agent-services#uptime_kuma_password")
