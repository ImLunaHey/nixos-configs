# @plugin(@varlock/hashicorp-vault-plugin@2.1.2)
# @initHcpVault(url=$BAO_ADDR, roleId=$VAULT_ROLE_ID, secretId=$VAULT_SECRET_ID)
# ---

BAO_ADDR=https://openbao.home.arpa:8200
VAULT_ROLE_ID=
# @sensitive
VAULT_SECRET_ID=

# @sensitive
BRRR_TOKEN=vaultSecret("secret/hosts/gilbert#brrr_token")
# @sensitive
HOMELAB_AGENT_SECRET=vaultSecret("secret/hosts/gilbert#homelab_agent_secret")
# @sensitive
MAKEMKV_KEY=vaultSecret("secret/hosts/gilbert#makemkv_key")
# @sensitive
OMDB_API_KEY=vaultSecret("secret/hosts/gilbert#omdb_api_key")
# @sensitive
RCON_PASSWORD=vaultSecret("secret/hosts/gilbert#rcon_password")
# @sensitive
RUSTIC_PASSWORD=vaultSecret("secret/hosts/gilbert#rustic_password")
# @sensitive
TAILSCALE_OAUTH=vaultSecret("secret/hosts/gilbert#tailscale_oauth")
