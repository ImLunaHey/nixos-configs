# @plugin(@varlock/hashicorp-vault-plugin@2.1.2)
# @initHcpVault(url=$BAO_ADDR, roleId=$VAULT_ROLE_ID, secretId=$VAULT_SECRET_ID)
# ---

BAO_ADDR=https://openbao.home.arpa:8200
VAULT_ROLE_ID=
# @sensitive
VAULT_SECRET_ID=

# @sensitive
BRRR_TOKEN=vaultSecret("secret/hosts/nova#brrr_token")
# @sensitive
CLOUDFLARE_API_TOKEN=vaultSecret("secret/hosts/nova#cloudflare_api_token")
# @sensitive
HOMELAB_AGENT_SECRET=vaultSecret("secret/hosts/nova#homelab_agent_secret")
# @sensitive
IMMICH_ENV=vaultSecret("secret/hosts/nova#immich_env")
# @sensitive
MATRIX_REGISTRATION_SECRET=vaultSecret("secret/hosts/nova#matrix_registration_secret")
# @sensitive
PIHOLE_PASSWORD=vaultSecret("secret/hosts/nova#pihole_password")
# @sensitive
ROMM_ENV=vaultSecret("secret/hosts/nova#romm_env")
# @sensitive
RUSTFS_ENV=vaultSecret("secret/hosts/nova#rustfs_env")
# @sensitive
RUSTIC_PASSWORD=vaultSecret("secret/hosts/nova#rustic_password")
# @sensitive
TAILSCALE_OAUTH=vaultSecret("secret/hosts/nova#tailscale_oauth")
# @sensitive
UPTIME_KUMA_PASSWORD=vaultSecret("secret/hosts/nova#uptime_kuma_password")
