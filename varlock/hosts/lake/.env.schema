# @plugin(@varlock/hashicorp-vault-plugin@2.1.2)
# @initHcpVault(url=$BAO_ADDR, roleId=$VAULT_ROLE_ID, secretId=$VAULT_SECRET_ID)
# ---

BAO_ADDR=https://openbao.home.arpa:8200
VAULT_ROLE_ID=
# @sensitive
VAULT_SECRET_ID=

# @sensitive
ANVIL_AUTH_SECRET=vaultSecret("secret/hosts/lake#anvil_auth_secret")
# @sensitive
BRRR_TOKEN=vaultSecret("secret/hosts/lake#brrr_token")
# @sensitive
HARMONIA_SIGNING_KEY=vaultSecret("secret/hosts/lake#harmonia_signing_key")
# @sensitive
HOMELAB_AGENT_SECRET=vaultSecret("secret/hosts/lake#homelab_agent_secret")
# @sensitive
LUMEN_T3CODE_PRIVATE_KEY=vaultSecret("secret/hosts/lake#lumen_t3code_private_key")
# @sensitive
SAMBA_PASSWORD=vaultSecret("secret/hosts/lake#samba_password")
# @sensitive
TAILSCALE_OAUTH=vaultSecret("secret/hosts/lake#tailscale_oauth")
