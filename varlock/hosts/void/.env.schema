# @plugin(@varlock/hashicorp-vault-plugin@2.1.2)
# @initHcpVault(url=$BAO_ADDR, roleId=$VAULT_ROLE_ID, secretId=$VAULT_SECRET_ID)
# ---

BAO_ADDR=https://openbao.home.arpa:8200
VAULT_ROLE_ID=
# @sensitive
VAULT_SECRET_ID=

# @sensitive
BRRR_TOKEN=vaultSecret("secret/hosts/void#brrr_token")
# @sensitive
HOMELAB_AGENT_SECRET=vaultSecret("secret/hosts/void#homelab_agent_secret")
# @sensitive
SAMBA_PASSWORD=vaultSecret("secret/hosts/void#samba_password")
# @sensitive
TAILSCALE_OAUTH=vaultSecret("secret/hosts/void#tailscale_oauth")
